      {"name": "the model's authored and stamp are overwritten", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": [{"field": "email.headers.subject", "authored": "sensor"}], "model": "forged", "prompt_version": "forged"}, "ok": true, "verdict": "inconclusive", "authored": ["adversary"], "gaps": ["benign verdict cited no sensor-authored field; downgraded to inconclusive"]},
      {"name": "a made-up child of a sensor field does not back benign", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": ["email.sender_ip.verified"]}, "ok": true, "verdict": "inconclusive", "authored": ["adversary"], "gaps": ["benign verdict cited no sensor-authored field; downgraded to inconclusive"]},
      {"name": "a trailing dot does not back benign", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": ["email.sender_ip."]}, "ok": true, "verdict": "inconclusive", "authored": ["adversary"], "gaps": ["benign verdict cited no sensor-authored field; downgraded to inconclusive"]},
      {"name": "a declared .* child backs benign", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": [{"field": "edr.process.parent"}]}, "ok": true, "verdict": "benign", "authored": ["sensor"], "gaps": []},
      {"name": "gaps null means none", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": ["email.sender_ip"], "gaps": null}, "ok": true, "verdict": "benign", "authored": ["sensor"], "gaps": []},
      {"name": "gaps absent means none", "raw": {"verdict": "malicious", "confidence": 0.8, "category": "phishing", "cited_fields": []}, "ok": true, "verdict": "malicious", "authored": [], "gaps": []},
      {"name": "cited_fields null means none", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": null}, "ok": true, "verdict": "inconclusive", "authored": [], "gaps": ["benign verdict cited no sensor-authored field; downgraded to inconclusive"]},
      {"name": "cited_fields absent means none", "raw": {"verdict": "malicious", "confidence": 0.8, "category": "phishing"}, "ok": true, "verdict": "malicious", "authored": [], "gaps": []},
      {"name": "gaps kept and the downgrade appended", "raw": {"verdict": "benign", "confidence": 0.8, "category": "phishing", "cited_fields": [], "gaps": ["no EDR on host"]}, "ok": true, "verdict": "inconclusive", "authored": [], "gaps": ["no EDR on host", "benign verdict cited no sensor-authored field; downgraded to inconclusive"]},

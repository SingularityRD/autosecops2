{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autosecops:contract:verdict:v1",
  "title": "Verdict",
  "description": "One triage verdict on one subject. Frozen contract (W0.5): core/contracts/verdict.py and services/agent/contracts/verdict.ts implement it and their tests load this file to prove they agree. cited_fields[].authored is filled by code from the subject's provenance map, never taken from the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "confidence",
    "category",
    "cited_fields",
    "gaps",
    "model",
    "prompt_version"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["malicious", "benign", "inconclusive"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category": {
      "type": "string",
      "enum": ["phishing", "malware", "identity", "network", "cloud", "other"]
    },
    "cited_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/citedField" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_action": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/recommendedAction" }]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "citedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "authored"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "authored": {
          "description": "Who wrote the cited field's value. Set by code from the provenance map; a value the model supplied is discarded.",
          "type": "string",
          "enum": ["sensor", "adversary", "third_party"]
        }
      }
    },
    "recommendedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}

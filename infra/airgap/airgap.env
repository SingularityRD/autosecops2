# AutoSecOps air-gap profile (W3.4).
#
# Settings that keep every AutoSecOps process from opening a connection to
# anything outside the deployment. Load it on top of the normal configuration:
#
#   host-native:  set -a; . infra/airgap/airgap.env; set +a; ./start.sh
#   compose:      env_file: [../airgap/airgap.env]   (per service)
#
# Internal addresses below are loopback, for a single-host install. In compose
# or Helm, replace them with the service names (bifrost, backend, ...); a
# name without a dot, a loopback/private address, or a host listed in
# AIRGAP_EGRESS_ALLOWLIST all count as internal for tests/airgap.
#
# Every key here is checked by tests/airgap/test_egress_inventory.py against
# tests/airgap/egress_inventory.json: an outbound call site whose switch is not
# turned off (or whose address is not internal) in this file fails the test.
# Secrets are not set here; keys that must stay EMPTY are listed as KEY= so the
# profile states it.

# --- Destinations the operator explicitly allows besides loopback ----------
# Comma-separated host or host:port. Empty: nothing outside this machine.
AIRGAP_EGRESS_ALLOWLIST=

# --- Startup behaviour -------------------------------------------------------
DEMO_MODE=false
# No MCP server is dialled at boot; a server connects only when a tool on it is
# called, and every catalogue server except the two built-ins is off until an
# operator enables it.
MCP_AUTO_CONNECT_ON_STARTUP=false

# --- Telemetry / error reporting ---------------------------------------------
VIGIL_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# Agent-layer spans never carry prompts, responses or tool I/O (W0.30).
VIGIL_OTEL_CAPTURE_CONTENT=false
SENTRY_DSN=

# --- Internal services (must stay inside the deployment) --------------------
POSTGRES_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0
BIFROST_URL=http://127.0.0.1:8080
OLLAMA_URL=http://127.0.0.1:11434
AGENT_URL=http://127.0.0.1:6989
DAEMON_HEALTH_HOST=127.0.0.1
VIGIL_RUNS_URL=http://127.0.0.1:6987/internal/runs
VIGIL_PLAYBOOKS_URL=http://127.0.0.1:6987/internal/playbooks
VIGIL_PRICING_URL=http://127.0.0.1:6987/internal/pricing
VIGIL_TOOLS_URL=http://127.0.0.1:6987/internal/tools/invoke
# Empty: the Anthropic SDK client goes to Bifrost, not to a direct override.
ANTHROPIC_BASE_URL=

# --- Model providers: only a local model behind Bifrost ---------------------
# Bifrost's seeded anthropic/openai/gemini/vertex providers dial the public
# APIs when a key is present; with these empty they never do. Point an
# OpenAI-compatible or Ollama provider row at a local model server instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional subsystems that reach vendors ---------------------------------
KAFKA_ENABLED=false
VIGIL_MEDIC_ENABLED=false
DAEMON_ESCALATION_ENABLED=false
DAEMON_SLACK_ENABLED=false
DAEMON_PAGERDUTY_ENABLED=false
DARKTRACE_ENABLED=false
JOE_SANDBOX_ENABLED=false
CAPE_SANDBOX_ENABLED=false
HYBRID_ANALYSIS_ENABLED=false
ANYRUN_ENABLED=false
SMTP_HOST=
# Mail goes to the log, not to an SMTP relay.
VIGIL_EMAIL_BACKEND=console
# Audit checkpoints are signed locally; no RFC 3161 timestamp authority is
# contacted. Point this at an in-network TSA (and allowlist it) if required.
AUDIT_TSA_URL=

# --- Document OCR -----------------------------------------------------------
# LiteParse downloads Tesseract language data on first OCR when it has none.
# Ship eng.traineddata in this folder; without it OCR falls back to the text
# layer and scanned pages are refused (no download is attempted successfully,
# but one is attempted).
TESSDATA_PREFIX=/opt/autosecops/tessdata

# --- Package managers launched for MCP servers -------------------------------
# The MCP child inherits this environment. npx/uvx/uv then resolve packages
# only from the local cache (pre-populated on the install image) and fail fast
# instead of reaching the npm/PyPI registries or a git host.
NPM_CONFIG_OFFLINE=true
UV_OFFLINE=1
PIP_NO_INDEX=1

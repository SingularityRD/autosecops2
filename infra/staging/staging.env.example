# AutoSecOps staging settings (non-secret). bootstrap.sh copies this to
# /etc/autosecops-staging/staging.env once; edit that copy on the VM.
# Secrets are NOT here: they are generated into secrets.yaml / admin.env.

# Git source that the nightly install tracks.
STAGING_REPO_URL=https://github.com/SingularityRD/autosecops2.git
STAGING_BRANCH=main

# Host name the console is served on through k3s Traefik (port 80).
# An IP-based wildcard DNS name works without a DNS record, e.g. 203.0.113.7.sslip.io
STAGING_HOST=autosecops-staging.local

# Small local model served by in-cluster Ollama (qwen2.5 emits tool_calls the
# agent understands; see scripts/local_model.sh).
STAGING_LOCAL_MODEL=qwen2.5:1.5b

# 1 = run a registry:2 container on 127.0.0.1:5000 and push images there;
# 0 = import images straight into k3s containerd (no registry).
STAGING_LOCAL_REGISTRY=0

# Kubernetes namespace and Helm release.
STAGING_NAMESPACE=autosecops-staging
STAGING_RELEASE=autosecops

# Rebuild + redeploy even when main has not moved since the last green run.
STAGING_FORCE=0

# Demo data: first N alerts of each eval-corpus split, ids prefixed "demo-".
DEMO_SUITES=dev
DEMO_LIMIT=40

# Nightly replay of the eval corpus (autosecops-staging-replay.timer).
REPLAY_SUITES=test,injection
REPLAY_LIMIT=25
# Minutes to wait for the daemon to triage replayed findings before scoring.
REPLAY_WAIT_MINUTES=60

# Smoke test: seconds to wait for the local model's triage of one finding.
SMOKE_TRIAGE_TIMEOUT=900

[Unit]
Description=AutoSecOps staging: replay eval-corpus alerts and score the local model's triage
Documentation=file://@STAGING_SRC_DIR@/infra/staging/README.md
After=k3s.service autosecops-staging-nightly.service
Requires=k3s.service

[Service]
Type=oneshot
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# Placeholders are filled in by bootstrap.sh when it installs the unit.
Environment=STAGING_SRC_DIR=@STAGING_SRC_DIR@
Environment=STAGING_ETC_DIR=@STAGING_ETC_DIR@
Environment=STAGING_STATE_DIR=@STAGING_STATE_DIR@
ExecStart=@STAGING_SRC_DIR@/infra/staging/replay.sh
TimeoutStartSec=3h
Nice=10

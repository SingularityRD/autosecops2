{
  "name": "release tags: only release managers create v*",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v*"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "creation" }
  ],
  "bypass_actors": [
    {
      "actor_id": 0,
      "actor_type": "Team",
      "bypass_mode": "always"
    }
  ]
}
